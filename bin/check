#!/usr/bin/env bash
# The local gate: the same checks as CI's typecheck, unit tests, credential checks, smoke and goal-usage steps.
set -euo pipefail
cd "$(dirname "$0")/.."

bun run verify
bun run test
bin/cnc help >/dev/null
bin/cnc teams >/dev/null
bin/cnc projects >/dev/null
bash .github/scripts/goal-usage.sh
echo "check: ok"
